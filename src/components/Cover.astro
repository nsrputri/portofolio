---
import type { SiteContent } from '../data/schema';
import BiImage from './BiImage.astro';
import CvLinks from './CvLinks.astro';
import Polaroid from './Polaroid.astro';
import T from './T.astro';
import Flower from './decor/Flower.astro';
import Paperclip from './decor/Paperclip.astro';
import Sticker from './decor/Sticker.astro';

interface Props {
  site: SiteContent['site'];
  ui: SiteContent['ui'];
}

const { site, ui } = Astro.props;
const { coverPhoto } = site;
// The photo is a backdrop, so its alt text is empty in both languages.
const DECORATIVE_ALT = { en: '', id: '' };
---

<header class:list={['cover', { 'cover--fallback': !coverPhoto }]}>
  <div class="cover-bg">
    {
      coverPhoto && (
        <BiImage
          src={coverPhoto}
          alt={DECORATIVE_ALT}
          loading="eager"
          fetchpriority="high"
          quality={60}
          widths={[640, 828, 1280, 1920]}
          sizes="100vw"
        />
      )
    }
  </div>

  <div class="cover-corners">
    {site.cornerLeft && <p class="cover-corner cover-corner--left"><T text={site.cornerLeft} rich /></p>}
    <p class="cover-corner cover-corner--right"><T text={site.cornerRight} rich /></p>
  </div>

  <span class="fl fl-1"><Flower /></span>
  <span class="fl fl-2"><Flower /></span>
  <span class="fl fl-3"><Flower /></span>

  <h1 class="cover-title"><T text={site.tagline} rich /></h1>

  <Polaroid class="cover-pol" src={site.portrait} alt={site.portraitAlt} pin />

  <div class="note">
    <Paperclip />
    <p><T text={site.note} /></p>
  </div>

  <div class="cover-id">
    <Sticker name={site.name} sub={site.stickerSub} />
    {site.cv && <CvLinks cv={site.cv} label={ui.downloadCv} />}
    <span class="status"><i aria-hidden="true"></i><T text={site.status} /></span>
  </div>
</header>

<style>
  .cover {
    /* Space the fixed language toggle takes at the top right: 12px inset + 82px wide + a gap. */
    --toggle-clear: 108px;
    /* Bounded by the height as well as the width: a laptop window loses 110-130px to the browser's own
       bars, and a tagline sized by width alone would push the closed folder tabs off the first screen. */
    --title-size: clamp(48px, min(9vw, 14vh), 128px);
    /* How far the note's bottom edge reaches below the top of the folder stack. The stack is 54px of
       empty tab row (with the folder's paper sheet starting 40px down) before its first opaque pixel,
       so the note can tuck in this far and still show every line. */
    --note-tuck: 36px;
    --note-width: clamp(200px, 20vw, 270px);
    /* The identity row (sticker, CV button, status pill) ends about 570px from the left edge in both
       languages with the dummy text, so the note never starts before this. A longer status wraps
       inside its pill to stay clear of the note (see .cover-id below). */
    --id-row-end: 580px;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    padding: 24px var(--gutter) var(--stack-h, 0px);
    color: #fff;
  }

  .cover-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cover-bg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-bg::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Darkens a real photo so the white text keeps its contrast. */
  .cover:not(.cover--fallback) .cover-bg::after {
    background: linear-gradient(
      180deg,
      rgba(18, 15, 12, 0.55),
      rgba(18, 15, 12, 0.4) 45%,
      rgba(18, 15, 12, 0.65)
    );
  }

  /* The stand-in gradient is light, so white text on it misses 4.5:1. A faint scrim, strongest behind
     the corner labels at the top and gone by the middle, fixes that without turning it into a dark
     slab. Its stops are in px because the labels and tagline sit at a fixed distance from the top. */
  .cover--fallback .cover-bg::after {
    background: linear-gradient(180deg, rgba(18, 15, 12, 0.2), rgba(18, 15, 12, 0.12) 240px, transparent 480px);
  }

  .cover--fallback .cover-bg {
    background:
      radial-gradient(55% 45% at 88% 8%, #56664a 0%, transparent 70%),
      radial-gradient(40% 40% at 8% 22%, #8c7a66 0%, transparent 72%),
      radial-gradient(60% 50% at 40% 70%, #b7ae9d 0%, transparent 70%),
      linear-gradient(180deg, #7a7d6c 0%, #a39b8b 100%);
  }

  .cover-corners {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-right: var(--toggle-clear);
    font: 500 clamp(11px, 1vw, 13px) / 1.4 var(--mono);
    letter-spacing: 0.14em;
  }

  .cover-corner--right {
    /* Stays in the right corner when there is no left label. */
    margin-left: auto;
    text-align: right;
  }

  .cover-title {
    margin: clamp(28px, 7vh, 72px) 0 0 clamp(0px, 14vw, 230px);
    font: 400 var(--title-size) / 0.88 var(--serif);
    letter-spacing: -0.015em;
  }

  .cover-title :global(em) {
    font-style: italic;
  }

  .fl {
    position: absolute;
    width: clamp(26px, 2.6vw, 38px);
    color: #fff;
    opacity: 0.9;
  }

  .fl-1 {
    top: 14%;
    left: 22%;
    rotate: 12deg;
  }

  .fl-2 {
    top: 27%;
    left: 14%;
    rotate: -20deg;
    width: clamp(20px, 2vw, 30px);
  }

  .fl-3 {
    top: 9%;
    right: 34%;
  }

  .cover :global(.cover-pol) {
    position: absolute;
    z-index: 2;
    top: clamp(96px, 15vh, 160px);
    right: clamp(16px, 5vw, 80px);
    width: clamp(120px, 14vw, 196px);
    rotate: 5deg;
  }

  .note {
    position: absolute;
    z-index: 2;
    /* Rests on the folder stack, which lies over the bottom of the cover, instead of hanging from the
       tagline: on a laptop-height window there is only about 130px between the two, so the note is
       sized to fit that (see its font below) and can never push the stack off the first screen. */
    bottom: calc(var(--stack-h, 0px) - var(--note-tuck));
    /* 100% is the cover's width, which leaves out a scrollbar where 100vw would include it. */
    right: min(clamp(120px, 17vw, 270px), calc(100% - var(--id-row-end) - var(--note-width)));
    width: var(--note-width);
    padding: 28px 16px 14px;
    rotate: -3deg;
    background: var(--paper);
    color: #33302d;
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.16);
  }

  .note p {
    font: 500 clamp(18px, 1.5vw, 22px) / 1.12 var(--hand);
  }

  .cover-id {
    margin-top: auto;
    padding: 22px 0 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  /* The links come from CvLinks, so this scope cannot reach them without :global. */
  .cover-id :global(.cv-link) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    background: #1f1e1c;
    color: #fff;
    text-decoration: none;
    font: 500 13px var(--mono);
    letter-spacing: 0.08em;
  }

  .cover-id :global(.cv-link:focus-visible) {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    /* Smoked rather than frosted: white text on the light gradient behind it was about 2:1. */
    background: rgba(20, 18, 15, 0.45);
    backdrop-filter: blur(6px);
    font: 500 12px var(--mono);
    letter-spacing: 0.08em;
  }

  .status i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #7ee2a0;
    box-shadow: 0 0 0 3px rgba(126, 226, 160, 0.3);
  }

  /* A short window (a laptop with the browser's bars, a phone held upright) has no height to spare
     above the tagline, so the gap under the corner labels shrinks to keep all four folder tabs on the
     first screen. */
  @media (max-height: 720px) {
    .cover-title {
      margin-top: clamp(14px, 3vh, 28px);
    }

    .cover-id {
      padding-top: 12px;
    }
  }

  /* Where the note shows, the identity row stops 10px short of it (its left edge, worked out from its
     `right` above; 100% here is the cover's width less both gutters). A status longer than the dummy
     one then wraps inside its pill, which stays shorter than the sticker, instead of running under the
     note; if even its longest word does not fit, it moves to a second line as on a phone. */
  @media (min-width: 881px) {
    .cover-id {
      max-width: calc(
        max(100% + 2 * var(--gutter) - clamp(120px, 17vw, 270px) - var(--note-width), var(--id-row-end)) -
          var(--gutter) - 10px
      );
    }

    .status {
      flex: 1 1 0;
      max-width: max-content;
    }
  }

  /* Too narrow for the note to sit beside the identity row. */
  @media (max-width: 880px) {
    .note {
      display: none;
    }
  }

  @media (max-width: 680px) {
    .cover {
      /* No room beside the corner labels, so the row sits below the toggle instead. */
      padding-top: 56px;
    }

    .cover-corners {
      padding-right: 0;
      font-size: 10px;
      letter-spacing: 0.1em;
    }

    .cover :global(.cover-pol),
    .fl-3 {
      display: none;
    }

    .cover-title {
      margin-left: 0;
    }

    /* Moves clear of the tagline, which now starts at the left edge. */
    .fl-2 {
      top: 25%;
      left: auto;
      right: 12%;
    }
  }
</style>
