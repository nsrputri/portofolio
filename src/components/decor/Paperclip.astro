---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class:list={['paperclip', className]} viewBox="0 0 26 70" aria-hidden="true" focusable="false">
  <path
    d="M9 22v32a6.5 6.5 0 0 0 13 0V12a9 9 0 0 0-18 0v44"
    fill="none"
    stroke="#9ea4ab"
    stroke-width="2.6"
    stroke-linecap="round"
  ></path>
</svg>

<style>
  /* Clips onto the top-left of the nearest positioned parent (a note or card). */
  .paperclip {
    position: absolute;
    top: -26px;
    left: 22px;
    width: 18px;
  }
</style>
