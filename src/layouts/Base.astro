---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/600.css';
import '@fontsource-variable/dm-sans';
import '@fontsource/silkscreen/400.css';
import '../styles/tokens.css';
import '../styles/global.css';
import type { Localized } from '../data/schema';

interface Props {
  title: Localized;
  description: Localized;
}

const { title, description } = Astro.props;
// Social previews and canonical links are language-neutral, so they always use English.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html
  lang="en"
  data-title-en={title.en}
  data-title-id={title.id}
  data-desc-en={description.en}
  data-desc-id={description.id}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title.en}</title>
    <meta name="description" content={description.en} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title.en} />
    <meta property="og:description" content={description.en} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Before first paint: sets the stored language so there is no flash of English (duplicates
         resolveLang() in src/scripts/lang.ts: inline scripts cannot import), and adds has-motion
         unless the visitor asked for reduced motion, so the folders start closed without a flash of
         them open. Without the class, folders.ts leaves every folder open. */}
    <script is:inline>
      try {
        if (localStorage.getItem('lang') === 'id') document.documentElement.lang = 'id';
      } catch (e) {}
      if (matchMedia('(prefers-reduced-motion: no-preference)').matches) document.documentElement.classList.add('has-motion');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
