---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Footer from '../components/Footer.astro';
import Folder from '../components/Folder.astro';
import LangToggle from '../components/LangToggle.astro';
import Lightbox from '../components/Lightbox.astro';
import AboutMe from '../components/folders/AboutMe.astro';
import Certificates from '../components/folders/Certificates.astro';
import StudyJourney from '../components/folders/StudyJourney.astro';
import WhatIDo from '../components/folders/WhatIDo.astro';
import { content } from '../data/content';
import { refuseDummyOnCloudflare } from '../data/deploy-guard';
import { folderPlace, visibleFolders } from '../data/visible-folders';

// A build on Cloudflare stops here while content.ts still holds any dummy text.
refuseDummyOnCloudflare(content, process.env);

const { folders } = content.ui;
// What I Do and Certificates only show once they have an item; the rest renumber and keep alternating tabs.
const shown = visibleFolders(content);
---

<Base title={content.site.title} description={content.site.description} folderCount={shown.length}>
  <LangToggle label={content.ui.language} />
  <Cover site={content.site} ui={content.ui} />
  <main class="stack">
    <Folder id="about" {...folderPlace(shown, 'about')} label={folders.about} color="pink">
      <AboutMe about={content.about} />
    </Folder>
    <Folder id="study" {...folderPlace(shown, 'study')} label={folders.study} color="beige">
      <StudyJourney study={content.study} />
    </Folder>
    {
      shown.includes('work') && (
        <Folder id="work" {...folderPlace(shown, 'work')} label={folders.work} color="blue">
          <WhatIDo work={content.work} ui={content.ui} />
        </Folder>
      )
    }
    {
      shown.includes('cert') && (
        <Folder id="cert" {...folderPlace(shown, 'cert')} label={folders.cert} color="butter">
          <Certificates certificates={content.certificates} ui={content.ui} />
        </Folder>
      )
    }
  </main>
  <Footer site={content.site} ui={content.ui} />
  <Lightbox close={content.ui.close} />
  <script>
    import { initFolders } from '../scripts/folders';

    initFolders(document);
  </script>
</Base>
